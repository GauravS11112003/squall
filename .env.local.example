# Copy this file to .env.local and add your key. .env.local is git-ignored.
# Create a key at https://clocked.rezolve.ai/account
CLOCKED_API_KEY=

# Optional. On a public deployment, require this code before any live (credit-spending) call.
# SQUALL_ACCESS_CODE=

# Optional, development only. With no key, run the labelled offline simulator instead of Clocked.
# SQUALL_SIM=1
